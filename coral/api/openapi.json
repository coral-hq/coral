        "description": "One open alert as the Inbox lists it: its row's fields merged with its payload.",
        "properties": {
          "actions": {
            "items": {
              "enum": [
                "answer",
                "open_run",
                "mark_read",
                "resume",
                "cancel"
              ],
              "type": "string"
            },
            "title": "Actions",
            "type": "array"
          },
          "alert_id": {
            "title": "Alert Id",
            "type": "string"
          },
          "approve_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approve Link"
          },
          "created_at": {
            "title": "Created At",
            "type": "integer"
          },
          "deep_link": {
            "title": "Deep Link",
            "type": "string"
          },
          "elicitation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elicitation Id"
          },
          "kind": {
            "enum": [
              "gate",
              "question",
              "pause",
              "watchdog",
              "overdue",
              "reaction",
              "run_completed",
              "run_failed",
              "run_cancelled"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node Id"
          },
          "outcomes": {
            "items": {
              "type": "string"
            },
            "title": "Outcomes",
            "type": "array"
          },
          "pause_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pause Reason"
          },
          "priority": {
            "enum": [
              "normal",
              "low"
            ],
            "title": "Priority",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "run_title": {
            "title": "Run Title",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "step_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Label"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "alert_id",
          "run_id",
          "run_title",
          "kind",
          "priority",
          "created_at",
          "title",
          "message",
          "step_label",
          "node_id",
          "actions",
          "deep_link",
          "approve_link",
          "elicitation_id",
          "session_id",
          "outcomes",
          "pause_reason"
        ],
        "title": "WorkflowAlertOut",
        "type": "object"
      },
      "WorkflowDetailOut": {
        "description": "A stored workflow definition with its YAML and compiled graph.",
        "properties": {
          "compiled": {
            "$ref": "#/components/schemas/CompiledGraph"
          },
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "runnable": {
            "title": "Runnable",
            "type": "boolean"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "integer"
          },
          "workflow_key": {
            "title": "Workflow Key",
            "type": "string"
          },
          "yaml": {
            "title": "Yaml",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workflow_key",
          "name",
          "content_hash",
          "runnable",
          "created_at",
          "updated_at",
          "yaml",
          "compiled"
        ],
        "title": "WorkflowDetailOut",
        "type": "object"
      },
      "WorkflowInboxPage": {
        "description": "One feed page. A page can be empty and still carry ``next_cursor``: keep paging\nuntil it is null.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/WorkflowAlertOut"
            },
            "title": "Data",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "data",
          "next_cursor"
        ],
        "title": "WorkflowInboxPage",
        "type": "object"
      },
      "WorkflowSummaryOut": {
        "description": "A stored workflow definition as lists show it.",
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "runnable": {
            "title": "Runnable",
            "type": "boolean"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "integer"
          },
          "workflow_key": {
            "title": "Workflow Key",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workflow_key",
          "name",
          "content_hash",
          "runnable",
          "created_at",
          "updated_at"
        ],
        "title": "WorkflowSummaryOut",
        "type": "object"
      },
      "WorkflowYaml": {
        "description": "A workflow document as YAML text.",
        "properties": {
          "yaml": {
            "title": "Yaml",
            "type": "string"
          }
        },
        "required": [
          "yaml"
        ],
        "title": "WorkflowYaml",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Coral API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/coral/inbox": {
      "get": {
        "description": "The caller's open alerts: normal priority first, newest first within each.",
        "operationId": "coral_list_inbox",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowInboxPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "List Inbox",
        "tags": [
          "coral"
        ]
      }
    },
    "/v1/coral/inbox/{alert_id}/ack": {
      "post": {
        "description": "Mark one of the caller's alerts read; marking it again changes nothing.",
        "operationId": "coral_ack_alert",
        "parameters": [
          {
            "in": "path",
            "name": "alert_id",
            "required": true,
            "schema": {
              "title": "Alert Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Ack Alert",
        "tags": [
          "coral"
        ]
      }
    },
    "/v1/coral/info": {
      "get": {
        "description": "Report whether Coral is enabled on this server and its sub-feature map.",
        "operationId": "coral_get_info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralInfoResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Coral Info",
        "tags": [
          "coral"
        ]
      }
    },
    "/v1/coral/workflows": {
      "get": {
        "description": "The caller's workflows, by key.",
        "operationId": "coral_list_workflows",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkflowSummaryOut"
                  },
                  "title": "Response Coral List Workflows",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "List Workflows",
        "tags": [
          "coral"
        ]
      },
      "post": {
        "description": "Store the caller's workflow under its key, replacing their earlier version.",
        "operationId": "coral_save_workflow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowYaml"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedWorkflowOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Save Workflow",
        "tags": [
          "coral"
        ]
      }
    },
    "/v1/coral/workflows/{workflow_id}": {
      "get": {
        "description": "One of the caller's workflows with its YAML and compiled graph.",
        "operationId": "coral_get_workflow",
        "parameters": [
          {
            "in": "path",
            "name": "workflow_id",
            "required": true,
            "schema": {
              "title": "Workflow Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Get Workflow",
        "tags": [
          "coral"
        ]
      }
    },
    "/v1/coral/workflows:validate": {
      "post": {
        "description": "Load, compile and validate a workflow without storing it.",
        "operationId": "coral_validate_workflow",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowYaml"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidResult"
                    },
                    {
                      "$ref": "#/components/schemas/InvalidResult"
                    }
                  ],
                  "title": "Response Coral Validate Workflow"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoralErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Validate Workflow",
        "tags": [
          "coral"
        ]
      }
    }
  }
}
