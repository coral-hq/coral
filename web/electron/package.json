{
  "name": "omnigent-desktop-electron",
  "productName": "Coral",
  "version": "0.21.0",
  "description": "Coral desktop shell, built on Omnigent",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/coral-hq/coral",
  "repository": {
    "type": "git",
    "url": "https://github.com/coral-hq/coral.git"
  },
  "author": {
    "name": "The Coral Authors",
    "email": "coralai.team@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder -c.appId=io.github.coral-hq.coral-dev -c.productName='Coral Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:mac": "electron-builder --mac -c.appId=io.github.coral-hq.coral-dev -c.productName='Coral Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:mac:release": "OMNIGENT_NOTARIZE_DMG=true electron-builder --mac -c.mac.notarize=true -c.dmg.sign=true",
    "build:linux": "electron-builder --linux -c.appId=io.github.coral-hq.coral-dev -c.productName='Coral Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:win": "electron-builder --win -c.appId=io.github.coral-hq.coral-dev -c.productName='Coral Dev' -c.directories.output=dist-dev -c.extraMetadata.omnigentBuild=dev",
    "build:overlay": "pnpm --filter web run build:overlay && pnpm --filter web run build:server-selector-v2",
    "predev": "pnpm run build:overlay",
    "prestart": "pnpm run build:overlay",
    "prebuild": "pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:overlay",
    "prebuild:win": "pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "io.github.coral-hq.coral",
    "productName": "Coral",
    "copyright": "Copyright © 2026 The Coral Authors. Portions Copyright (2026) Databricks, Inc. (Omnigent, Apache-2.0).",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Coral session link",
        "schemes": [
          "coral"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/coral-hq/coral/releases/latest/download/"
      }
    ],
    "afterPack": "build/afterPack.js",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "files": [
      "src/**/*",
      "about/**/*",
      "browser-permission/**/*",
      "workspace-picker/**/*",
      "setup/**/*",
      "arca-connect/**/*",
      "ssh-connect/**/*",
      "server-selector-v2/**/*",
      "find/**/*",
      "return-banner/**/*",
      "connection-loading/**/*",
      "reconnect-overlay/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../scripts/install_oss.sh",
        "to": "install_oss.sh"
      },
      {
        "from": "../../LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "legal/NOTICE"
      },
      {
        "from": "../../MODIFICATIONS.md",
        "to": "legal/MODIFICATIONS.md"
      },
      {
        "from": "../public/licenses/geist-mono-OFL-1.1.txt",
        "to": "legal/geist-mono-OFL-1.1.txt"
      },
      {
        "from": "../public/licenses/newsreader-OFL-1.1.txt",
        "to": "legal/newsreader-OFL-1.1.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/coral-icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Coral uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon",
        "NSPrefersDisplaySafeAreaCompatibilityMode": false
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/coral-hq/coral/releases/latest/download/"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/coral-background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/coral-icon.svg",
      "category": "Development",
      "maintainer": "The Coral Authors <coralai.team@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/coral-hq/coral/releases/latest/download/"
        }
      ]
    },
    "win": {
      "icon": "icons/coral-icon.ico",
      "target": [
        "nsis"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/coral-hq/coral/releases/latest/download/"
        }
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2"
  }
}
